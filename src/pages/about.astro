---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillTag from '../components/SkillTag.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

const coreSkills = [
  'Content Strategy', 'UX Writing', 'Voice & Tone', 'Content Systems',
  'Cross-Functional Collaboration', 'Data-Driven Decisions', 'Content Auditing',
  'Stakeholder Management', 'User Research Integration', 'Information Architecture',
  'AI/LLM Collaboration', 'Experimentation & A/B Testing', 'Conversion Optimization',
  'Financial Services', 'Brand Strategy',
];

const metrics = [
  { project: 'Proactive Intervention', metric: 'Annualized revenue', result: '$5M' },
  { project: 'Proactive Intervention', metric: 'CTR improvement', result: '3.5x' },
  { project: 'Proactive Intervention', metric: 'Resolution rate', result: '+7%' },
  { project: 'CKM Splash / Contract 1', metric: 'CTR improvement', result: '17% → 32%' },
  { project: 'CKM Splash / Contract 1', metric: 'Incremental filings', result: '52K' },
  { project: 'CKM Splash / Contract 1', metric: 'YoY unit growth', result: '5X to 313K' },
  { project: 'Expert Final Review', metric: 'Annualized revenue', result: '$1.8M' },
  { project: 'CKM Splash', metric: 'CTA optimization', result: '+10% filing starts' },
];
---

<BaseLayout title="About — Holly Zorbas" description="Content designer + UX writer who builds systems, not just screens.">
  <section class="section">
    <div class="about-grid">
      <Image
        src={headshot}
        alt="Holly Zorbas"
        width={520}
        height={693}
        class="about-photo"
      />
      <div>
        <h1>about me</h1>
        <div class="prose" style="margin-top: var(--space-6);">
          <p>
            i like to deeply understand who i'm writing for before anything else, but i know that speed matters. i've spent my career pivoting and adapting, and i love working in spaces where craft execution is swift, but doesn't sacrifice strategy and care. 
          </p>
          <p>
            over several contract engagements at intuit, i worked on complex, cross-product experiences where the content had to reduce confusion, build trust, and move people through complicated tasks. a few of those projects drove measurable revenue. 
          </p>
          <p>
            when i'm not working, there's a good chance i'm either a) scouting for new boba shops, b) thumbing through a horror manga, or c) being mediocre at weighlifting. i also like to tinker with ai tools (wow employable!). i've built <a href="https://github.com/hollyzorbas-hash">a few lil projects</a>, including this site, using claude code. it's a space i want to keep growing in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section" style="padding-top: 0;">
    <h2>skills</h2>
    <div class="skills-grid">
      {coreSkills.map((s) => <SkillTag label={s} />)}
    </div>
  </section>

  <!-- Contact -->
  <section class="section" style="padding-top: 0;" id="contact">
    <h2>get in touch</h2>
    <div class="prose">
      <p>
        i'm currently looking for my next content role. if you think we'd be a good fit, give me a shout.
      </p>
      <p>
        <a href="mailto:hollyzorbas@gmail.com">email</a> &middot;
        <a href="https://www.linkedin.com/in/hollyzorbas/" target="_blank" rel="noopener">linkedin</a>
      </p>
    </div>
  </section>
</BaseLayout>
