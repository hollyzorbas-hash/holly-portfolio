---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import imgBudgetCalc from '../../assets/projects/creditdonkey-budget.png';
import imgEmergencyFund from '../../assets/projects/creditdonkey-emergency.png';
---

<BaseLayout
  title="Personal Finance Editorial — Holly Zorbas"
  description="Long-form personal finance editorial for CreditDonkey."
>
  <article class="earlier-work-page">
    <!-- Header -->
    <header class="page-header">
      <a href="/#work" class="back-link">&larr; back to work</a>
      <p class="project-label">CreditDonkey.com</p>
      <h1>Personal Finance Editorial</h1>
      <p class="project-tagline">long-form explainers on budgeting and saving for a consumer audience — written to be readable, not just rankable.</p>
    </header>

    <!-- Item 1: Image Left, Text Right -->
    <section class="content-row">
      <div class="content-image scrollable">
        <Image src={imgBudgetCalc} alt="50/30/20 Budget Calculator" width={600} densities={[1, 2]} />
      </div>
      <div class="content-text">
        <h2>50/30/20 Budget Calculator</h2>
        <p>Long-form personal finance explainer for a consumer audience. Covers the budgeting rule, how to adapt it, and when it breaks down.</p>
        <p class="content-tag">Personal Finance · Editorial</p>
        <a href="https://www.creditdonkey.com/50-30-20-calculator.html" target="_blank" rel="noopener" class="content-link">Read article →</a>
      </div>
    </section>

    <!-- Item 2: Text Left, Image Right -->
    <section class="content-row">
      <div class="content-text">
        <h2>Emergency Fund Calculator</h2>
        <p>Structured explainer for a multi-variable concept — breaks down how expenses, risk factors, and existing savings interact to determine the right fund size.</p>
        <p class="content-tag">Personal Finance · Editorial</p>
        <a href="https://www.creditdonkey.com/emergency-fund-calculator.html" target="_blank" rel="noopener" class="content-link">Read article →</a>
      </div>
      <div class="content-image scrollable">
        <Image src={imgEmergencyFund} alt="Emergency Fund Calculator" width={600} densities={[1, 2]} />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .earlier-work-page {
    max-width: 100%;
  }

  /* Header */
  .page-header {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-12);
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--color-muted);
    display: inline-block;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-text);
    opacity: 1;
  }

  .project-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .page-header h1 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: var(--space-3);
    line-height: 1.2;
  }

  .project-tagline {
    font-size: 1rem;
    color: var(--color-muted);
    max-width: 500px;
    line-height: 1.6;
  }

  /* Content Rows */
  .content-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    margin-bottom: calc(var(--space-16) * 2);
  }

  .content-row:last-child {
    margin-bottom: var(--space-12);
  }

  .content-row-reversed {
    direction: rtl;
  }

  .content-row-reversed > * {
    direction: ltr;
  }

  /* Image */
  .content-image {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .content-image.scrollable {
    aspect-ratio: 4 / 3;
    overflow-y: scroll;
  }

  /* Always show scrollbar */
  .content-image.scrollable::-webkit-scrollbar {
    width: 8px;
  }

  .content-image.scrollable::-webkit-scrollbar-track {
    background: var(--color-accent);
  }

  .content-image.scrollable::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }

  .content-image.scrollable::-webkit-scrollbar-thumb:hover {
    background: var(--color-muted);
  }

  .content-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  /* Text */
  .content-text h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: var(--space-4);
    line-height: 1.3;
  }

  .content-text p {
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .content-tag {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .content-link {
    display: inline-block;
    font-size: 0.875rem;
    margin-top: var(--space-2);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .content-row {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .content-row-reversed {
      direction: ltr;
    }

    .content-row-reversed .content-image {
      order: -1;
    }
  }
</style>
